DATABASE_URL=your_DATABASE_URL_here

SUPABASE_URL=your_SUPABASE_URL_here
SUPABASE_ANON_KEY=your_SUPABASE_ANON_KEY_here
SUPABASE_SERVICE_ROLE_KEY=your_SUPABASE_SERVICE_ROLE_KEY_here
SUPABASE_JWKS_URL=your_SUPABASE_JWKS_URL_here

GEMINI_API_KEY=your_GEMINI_API_KEY_here
EMBEDDING_MODEL=your_EMBEDDING_MODEL_here
EMBEDDING_DIMENSIONS=your_EMBEDDING_DIMENSIONS_here

# Groq Alternative LLM Provider (OpenAI-compatible)
USE_GROQ_FOR_QUERY_REWRITE=false
USE_GROQ_FOR_GENERATION=false
GROQ_API_KEY=your_GROQ_API_KEY_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_QUERY_REWRITE_MODEL=openai/gpt-oss-120b
GROQ_CHAT_LLM_MODEL=openai/gpt-oss-120b

# Langfuse is the sole observability platform. Leave keys empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false